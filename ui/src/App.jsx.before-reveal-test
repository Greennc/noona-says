        )}
      </footer>
    </div>
  );
}


/* ============================================================ *
 * SyllableBuilder - drag/tap letters to build syllables
 * ============================================================ */
function SyllableBuilder({ section, done, onComplete }) {
  const [picked, setPicked] = useState([]);
  const [showHint, setShowHint] = useState(false);

  // Determine how many letters each target syllable needs
  // by counting jamos in each target syllable (decompose Hangul)
  const syllableLengths = (section.target_syllables || []).map(syl => decomposeHangul(syl).length);
  
  // Group picked letters into syllables based on those lengths
  const syllables = [];
  let cursor = 0;
  for (const len of syllableLengths) {
    if (picked.length >= cursor + len) {
      const jamoChunk = picked.slice(cursor, cursor + len).map(i => section.letters[i]);
      syllables.push(composeHangul(jamoChunk));
      cursor += len;
    } else if (picked.length > cursor) {
      // Partial syllable: just show jamos as-is
      const partial = picked.slice(cursor).map(i => section.letters[i]).join("");
      syllables.push(partial);
      cursor = picked.length;
    }
  }

  const builtWord = syllables.join("");
  const targetWord = section.target_word;
  const isComplete = builtWord === targetWord;

  // When complete, trigger onComplete
  useEffect(() => {
    if (isComplete && !done) {
      onComplete();
    }
  }, [isComplete, done]);

  const reset = () => {
    setPicked([]);
  };

  return (
    <section className="hangul-section syllable-build">
      <h2>{section.title}</h2>
      <p className="recognition-prompt">{section.prompt}</p>
      
      <div className="builder-output">
        <div className="builder-output-label">Your word:</div>
        <div className="builder-output-word">
          {syllables.length > 0 ? syllables.join("") : <span className="builder-placeholder">_</span>}
        </div>
        {isComplete && (
          <div className="builder-success">
            <div className="builder-success-text">
              <strong>{section.target_word}</strong> · <em>{section.romanization}</em> · {section.english}
            </div>
            <WordAudioButton word={section.target_word} />
          </div>
        )}
      </div>

      <div className="builder-letters">
        {section.letters.map((letter, i) => {
          const usedCount = picked.filter(p => p === i).length;
          const totalCount = section.letters.filter((l, idx) => l === letter).length;
          // Simple approach: disable letter if already used N times where N = how many times it appears in target
          // For our purposes, just allow each picked once
          return (
            <button
              key={i}
              className="builder-letter"
              onClick={() => {
                if (picked.includes(i)) return;
                if (done) return;
                setPicked(p => [...p, i]);
              }}
              disabled={picked.includes(i) || done}
            >
              {letter}
            </button>
          );
        })}
      </div>

      <div className="builder-actions">
        {!done && (
          <button className="builder-reset" onClick={reset} disabled={picked.length === 0}>
            ↺ reset
          </button>
        )}
        {!done && !showHint && (
          <button className="builder-hint" onClick={() => setShowHint(true)}>
            need a hint?
          </button>
        )}
      </div>

      {showHint && !done && (
        <div className="builder-hint-text">{section.hint}</div>
      )}
    </section>
  );
}

// Hangul Unicode tables
const HANGUL_LEADS = ["ㄱ","ㄲ","ㄴ","ㄷ","ㄸ","ㄹ","ㅁ","ㅂ","ㅃ","ㅅ","ㅆ","ㅇ","ㅈ","ㅉ","ㅊ","ㅋ","ㅌ","ㅍ","ㅎ"];
const HANGUL_VOWELS = ["ㅏ","ㅐ","ㅑ","ㅒ","ㅓ","ㅔ","ㅕ","ㅖ","ㅗ","ㅘ","ㅙ","ㅚ","ㅛ","ㅜ","ㅝ","ㅞ","ㅟ","ㅠ","ㅡ","ㅢ","ㅣ"];
const HANGUL_TAILS = ["","ㄱ","ㄲ","ㄳ","ㄴ","ㄵ","ㄶ","ㄷ","ㄹ","ㄺ","ㄻ","ㄼ","ㄽ","ㄾ","ㄿ","ㅀ","ㅁ","ㅂ","ㅄ","ㅅ","ㅆ","ㅇ","ㅈ","ㅊ","ㅋ","ㅌ","ㅍ","ㅎ"];

// Decompose a Hangul syllable into its jamo components
function decomposeHangul(syllable) {
  if (!syllable) return [];
  const code = syllable.charCodeAt(0) - 0xAC00;
  if (code < 0 || code >= 11172) return [syllable]; // not a Hangul syllable
  const L = Math.floor(code / (21 * 28));
  const V = Math.floor((code % (21 * 28)) / 28);
  const T = code % 28;
  const result = [HANGUL_LEADS[L], HANGUL_VOWELS[V]];
  if (T > 0) result.push(HANGUL_TAILS[T]);
  return result;
}

// Compose jamos into a Hangul syllable
// Accepts an array of 2 or 3 jamos: [consonant, vowel] or [consonant, vowel, batchim]
function composeHangul(jamos) {
  if (!jamos || jamos.length < 2) return jamos.join("");
  const [lead, vowel, tail] = jamos;
  const L = HANGUL_LEADS.indexOf(lead);
  const V = HANGUL_VOWELS.indexOf(vowel);
  const T = tail ? HANGUL_TAILS.indexOf(tail) : 0;
  if (L === -1 || V === -1 || T === -1) {
    return jamos.join(""); // fallback to plain concatenation
  }
  const code = 0xAC00 + (L * 21 * 28) + (V * 28) + T;
  return String.fromCharCode(code);
}

// Legacy alias for old code
function combineHangul(consonant, vowel) {
  return composeHangul([consonant, vowel]);
}


/* ============================================================ *
 * WordAudioButton - plays the audio for a completed word
 * ============================================================ */
function WordAudioButton({ word }) {
  const [playing, setPlaying] = useState(null); // 'normal' | 'slow' | null
  const [loading, setLoading] = useState(null);

  const play = async (speed) => {
    if (playing || loading) return;
    setLoading(speed);
    try {
      const url = speed === 'slow'
        ? `${API_BASE}/hangul/word/${encodeURIComponent(word)}/audio?speed=slow`
        : `${API_BASE}/hangul/word/${encodeURIComponent(word)}/audio`;
      const res = await authFetch(url);
      const data = await res.json();
      setLoading(null);
      if (data.audio_base64) {
        setPlaying(speed);
        const audio = new Audio(`data:audio/mpeg;base64,${data.audio_base64}`);
        audio.onended = () => setPlaying(null);
        audio.play();
      }
    } catch (err) {
      console.error("word audio failed", err);
      setLoading(null);
    }
  };

  return (
    <div className="word-audio-buttons">
      <button 
        className={`word-audio-btn ${playing === 'normal' ? 'playing' : ''}`}
        onClick={() => play('normal')}
        disabled={!!loading || !!playing}
      >
        {loading === 'normal' ? '...' : playing === 'normal' ? '♪ playing' : '♪ hear it'}
      </button>
      <button 
        className={`word-audio-btn slow ${playing === 'slow' ? 'playing' : ''}`}
        onClick={() => play('slow')}
        disabled={!!loading || !!playing}
      >
        {loading === 'slow' ? '...' : playing === 'slow' ? '♪ playing' : '🐢 slower'}
      </button>
    </div>
  );
}
