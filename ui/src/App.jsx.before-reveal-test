                  <>Not quite — try again. {section.explanation}</>
                )}
              </div>
            )}
          </section>
        )}

        {section?.type === 'syllable-build' && (
          <SyllableBuilder 
            section={section}
            done={practiceState[currentSection]?.done}
            onComplete={() => {
              setPracticeState(prev => ({
