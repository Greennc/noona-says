app.get('/lesson/:scenario_id', requireAuth, async (req, res) => {
  try {
    const { scenario_id } = req.params;

    // Check if lesson already exists in cache
    const { data: existingLesson } = await supabase
      .from('kr_lessons')
      .select('*')
      .eq('scenario_id', scenario_id)
      .maybeSingle();

    if (existingLesson) {
