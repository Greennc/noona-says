import { useEffect, useMemo, useRef, useState } from "react";
import "./index.css";

/*
 * noona says — Korean practice in a quiet Seoul journal.
 *
 * Drop-in App.jsx. Pairs with index.css.
 * Talks to your existing API:
 *   GET  /scenarios
 *   POST /start-conversation       { scenario_id }
 *   POST /chat                     { conversation_id, message }
 *   GET  /conversation/:id
 */

const API_BASE = import.meta.env?.VITE_API_BASE ?? "";

/* ------------------------------------------------------------------ *
 * Auth: read ?key= from URL, persist to localStorage, send as header
 * ------------------------------------------------------------------ */
const AUTH_KEY_STORAGE = "noonasays.app_key";

function captureKeyFromURL() {
  const params = new URLSearchParams(window.location.search);
  const key = params.get("key");
  if (key) {
    localStorage.setItem(AUTH_KEY_STORAGE, key);
    // Clean the URL so the key isn't visible in the address bar
    const cleanUrl = window.location.origin + window.location.pathname + window.location.hash;
    window.history.replaceState({}, document.title, cleanUrl);
  }
  return localStorage.getItem(AUTH_KEY_STORAGE);
}

function getStoredKey() {
  return localStorage.getItem(AUTH_KEY_STORAGE);
}

function clearStoredKey() {
  localStorage.removeItem(AUTH_KEY_STORAGE);
}

/* Wrapper around fetch that automatically adds the x-app-key header */
async function authFetch(url, options = {}) {
  const key = getStoredKey();
  const headers = { ...(options.headers || {}) };
  if (key) headers["x-app-key"] = key;
  return fetch(url, { ...options, headers });
}


/* ------------------------------------------------------------------ *
 * Character styling (fallback look — colored discs with initial).
 * Add real PNGs to /public/characters/<slug>.png and they'll be used.
 * ------------------------------------------------------------------ */
const CHARACTER_STYLES = {
  noona:  { color: "var(--noona)",  hangul: "누나",   initial: "누" },
  minji:  { color: "var(--minji)",  hangul: "민지",   initial: "민" },
  park:   { color: "var(--taxi)",   hangul: "박기사", initial: "박" },
  jihye:  { color: "var(--bar)",    hangul: "지혜",   initial: "지" },
  eomma:  { color: "var(--host)",   hangul: "이모",   initial: "이" },
  _default: { color: "var(--peach)", hangul: "", initial: "?" },
};

function characterStyle(name = "") {
  const key = String(name).toLowerCase().replace(/[^a-z]/g, "");
  return CHARACTER_STYLES[key] || { ...CHARACTER_STYLES._default, initial: (name[0] || "?").toUpperCase() };
}

function characterSlug(name = "") {
  return String(name).toLowerCase().trim().replace(/\s+/g, "-");
}

/* ============================================================ *
 * Root
 * ============================================================ */
export default function App() {
  const [view, setView] = useState({ kind: "picker" });
  const [demoStatus, setDemoStatus] = useState(null);
  const [authState, setAuthState] = useState({ checking: true, authorized: false, demo: false });

  // On mount: capture URL key, then verify with the server
  useEffect(() => {
    captureKeyFromURL();
    authFetch(`${API_BASE}/auth/check`)
      .then(r => r.json())
      .then(data => {
        setAuthState({
          checking: false,
          authorized: !!data.authorized,
          demo: !!data.demo
        });
      })
      .catch(err => {
        console.error("auth check failed", err);
        setAuthState({ checking: false, authorized: false, demo: false });
      });
  }, []);

  // Check if this is demo mode and fetch status
  useEffect(() => {
    authFetch(`${API_BASE}/demo/status`)
      .then(r => r.json())
      .then(data => {
        if (data.demo) {
          setDemoStatus(data);
        }
      })
      .catch(err => console.error("demo status fetch failed", err));
  }, [view.kind]); // refetch when view changes (after sending messages)

  // Still checking auth - show a tiny loading state
  if (authState.checking) {
    return (
      <div className="auth-loading">
        <div className="auth-loading-disc">누</div>
      </div>
    );
  }

  // Not authorized AND not demo - show lock screen
  if (!authState.authorized) {
    return <LockScreen />;
  }

  // If demo is blocked (daily cap or visitor cap), show block screen
  if (demoStatus?.blocked) {
    if (demoStatus.reason === "daily_cap") {
      return <DailyFullScreen />;
    }
    return <SoftBlockScreen />;
  }


  const startLesson = (scenario) => {
    setView({ kind: "lesson", scenario });
  };

  const startConversation = async (scenario) => {
    setView({ kind: "loading-chat", scenario });
    try {
      const res = await authFetch(`${API_BASE}/start-conversation`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ scenario_id: scenario.id }),
      });
      const data = await res.json();
      setView({
        kind: "chat",
        conversationId: data.conversation_id,
        scenario: data.scenario || scenario,
        seedMessage: data.opening_message,
      });
    } catch (err) {
      console.error("start-conversation failed", err);
      setView({ kind: "picker", error: "Couldn't start the scene. Try again?" });
    }
  };

  return (
    <div className="app-shell">
      {demoStatus && !demoStatus.blocked && (
        <DemoBanner status={demoStatus} />
      )}
      {view.kind === "picker" && (
        <ScenarioPicker
          onPick={startLesson}
          error={view.error}
          onLearnHangul={() => setView({ kind: "hangul-list" })}
        />
      )}
      {view.kind === "hangul-list" && (
        <HangulLessonList
          onPickLesson={(seqOrder) => setView({ kind: "hangul-lesson", seqOrder })}
          onBack={() => setView({ kind: "picker" })}
        />
      )}
      {view.kind === "hangul-lesson" && (
        <HangulLesson
          seqOrder={view.seqOrder}
          onBack={() => setView({ kind: "hangul-list" })}
          onComplete={() => setView({ kind: "hangul-list" })}
        />
      )}
      {view.kind === "lesson" && (
        <LessonScreen
          scenario={view.scenario}
          onStartChat={() => startConversation(view.scenario)}
          onBack={() => setView({ kind: "picker" })}
        />
      )}
      {view.kind === "loading-chat" && (
        <ChatLoadingCurtain scenario={view.scenario} />
      )}
      {view.kind === "chat" && (
        <ChatScreen
          key={view.conversationId}
          conversationId={view.conversationId}
          scenario={view.scenario}
          seedMessage={view.seedMessage}
          onBack={() => setView({ kind: "picker" })}
          onDemoUpdate={(demoData) => {
            setDemoStatus(prev => prev ? {
              ...prev,
              messagesUsed: demoData.messagesUsed,
              messagesRemaining: demoData.messagesRemaining,
              messagesCap: demoData.messagesCap
            } : null);
          }}
          onDemoBlocked={(reason, message) => {
            setDemoStatus(prev => ({
              ...(prev || {}),
              demo: true,
              blocked: true,
              reason,
              message
            }));
          }}
        />
      )}
    </div>
  );
}

/* ============================================================ *
 * Scenario Picker
 * ============================================================ */
function ScenarioPicker({ onPick, error, onLearnHangul }) {
  const [scenarios, setScenarios] = useState(null);
  const [fetchError, setFetchError] = useState(null);

  useEffect(() => {
    let cancelled = false;
    authFetch(`${API_BASE}/scenarios`)
      .then(r => r.json())
      .then(data => { if (!cancelled) setScenarios(Array.isArray(data) ? data : (data.scenarios || [])); })
      .catch(err => { if (!cancelled) setFetchError(err.message || "Network error"); });
    return () => { cancelled = true; };
  }, []);

  const today = useMemo(() => {
    return new Date().toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" });
  }, []);

  return (
    <main className="picker stage">
      <header className="picker-head">
        <div>
          <span className="eyebrow">Quiet Korean · A small daily habit</span>
          <h1 className="brand">
            <span className="brand-mark">noona <span className="says">says</span></span>
            <span className="brand-hangul">누나가 말하길</span>
          </h1>
          <span className="brand-sub">
            Slow, kind Korean practice in real Seoul places. Pick a scene and step inside.
          </span>
        </div>
        <div className="weather-strip">
          <strong>{today}</strong>
          서울 · good morning
        </div>
      </header>

      {(error || fetchError) && (
        <div className="notice" role="alert">{error || fetchError}</div>
      )}

      <div className="section-label">
        <h2>Today's scenes</h2>
        <span className="count">{scenarios ? `${scenarios.length} available` : "loading…"}</span>
      </div>

      {scenarios === null ? (
        <PickerSkeleton />
      ) : (
        <div className="cards">
          <HangulCallout onLearnHangul={onLearnHangul} />
          {scenarios.map((s, i) => (
            <ScenarioCard key={s.id ?? i} scenario={s} index={i} onPick={() => onPick(s)} />
          ))}
        </div>
      )}

      <footer className="picker-foot">
        <span>누나는 기다리고 있어요</span>
        <span>v 0.3</span>
      </footer>
    </main>
  );
}

function ScenarioCard({ scenario, index, onPick }) {
  // Tolerate either { title_kr, title_en, ... } or simpler API shapes.
  const titleKr     = scenario.title_kr   ?? scenario.titleKr   ?? scenario.title ?? "";
  const titleEn     = scenario.title_en   ?? scenario.titleEn   ?? scenario.subtitle ?? "";
  const location    = scenario.location   ?? scenario.place     ?? "";
  const blurb       = scenario.description ?? scenario.blurb    ?? "";
  const difficulty  = Number(scenario.difficulty ?? 1);
  const duration    = scenario.duration   ?? scenario.estimated_minutes ?? "";
  const characterName = scenario.character?.name ?? scenario.character_name ?? "Noona";

  return (
    <button className="card" onClick={onPick} style={{ animationDelay: `${0.05 * index}s` }}>
      <div className="card-top">
        <div className="card-meta">
          {location && <span className="card-location">{location}</span>}
          <h3 className="card-title">
            {titleKr || titleEn}
            {titleKr && titleEn && <span className="card-title-en">{titleEn}</span>}
          </h3>
        </div>
        <div className="card-stamp" aria-hidden="true">
          <Avatar name={characterName} size={44} />
          <span className="stamp-name">{characterName}</span>
        </div>
      </div>

      {blurb && <p className="card-body">{blurb}</p>}

      <div className="card-foot">
        <span className="difficulty">
          <span className="diff-pips">
            {[0,1,2].map(i => (
              <span key={i} className={i < difficulty ? "on" : ""}></span>
            ))}
          </span>
          {difficulty === 1 ? "Gentle" : difficulty === 2 ? "Steady" : "A stretch"}
          {duration && ` · ${typeof duration === "number" ? `${duration} min` : duration}`}
        </span>
        <span className="card-cta">Step inside</span>
      </div>

      <span className="card-corner">№ {String(index + 1).padStart(2, "0")}</span>
    </button>
  );
}

function PickerSkeleton() {
  return (
    <div className="cards">
      {[0,1,2,3].map(i => (
        <div className="card skeleton" key={i} aria-hidden="true">
          <div className="sk-line w70" />
          <div className="sk-line w90 lg" />
          <div className="sk-line w95" />
          <div className="sk-line w60" />
        </div>
      ))}
    </div>
  );
}

/* ============================================================ *
 * Chat
 * ============================================================ */
function ChatScreen({ conversationId, scenario, seedMessage, onBack, onDemoUpdate, onDemoBlocked }) {
  const [messages, setMessages] = useState(() => seedMessage ? [seedMessage] : []);
  const [draft, setDraft] = useState("");
  const [sending, setSending] = useState(false);
  const [showRoman, setShowRoman] = useState(() => readPref("show-roman", true));
  const [showEn, setShowEn] = useState(() => readPref("show-en", true));
  const [showCorrections, setShowCorrections] = useState(() => readPref("show-corrections", true));

  const scrollerRef = useRef(null);
  const textareaRef = useRef(null);

  // Hydrate full message list if we only have the seed
  useEffect(() => {
    if (!conversationId) return;
    let cancelled = false;
    authFetch(`${API_BASE}/conversation/${conversationId}`)
      .then(r => r.json())
      .then(data => {
        if (cancelled) return;
        if (Array.isArray(data?.messages) && data.messages.length) {
          setMessages(data.messages);
        }
      })
      .catch(err => console.warn("conversation hydrate failed", err));
    return () => { cancelled = true; };
  }, [conversationId]);

  // Persist toggle prefs
  useEffect(() => writePref("show-roman", showRoman), [showRoman]);
  useEffect(() => writePref("show-en", showEn), [showEn]);
  useEffect(() => writePref("show-corrections", showCorrections), [showCorrections]);

  // Autoscroll
  useEffect(() => {
    const el = scrollerRef.current;
    if (!el) return;
    el.scrollTop = el.scrollHeight;
  }, [messages, sending]);

  // Autosize textarea
  useEffect(() => {
    const ta = textareaRef.current;
    if (!ta) return;
    ta.style.height = "auto";
    ta.style.height = Math.min(ta.scrollHeight, 140) + "px";
  }, [draft]);

  const send = async () => {
    const text = draft.trim();
    if (!text || sending) return;

    const optimistic = {
      id: `local-${Date.now()}`,
      role: "user",
      user_input: text,
      content_korean: text,
      content_romanization: "",
      content_english: "",
    };
    setMessages(m => [...m, optimistic]);
    setDraft("");
    setSending(true);

    try {
      const res = await authFetch(`${API_BASE}/chat`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ conversation_id: conversationId, message: text }),
      });
      const data = await res.json();

      // Demo: if API blocked us, surface it instead of pushing an empty message
      if (data.demo_blocked) {
        setMessages(m => m.map(msg => msg.id === optimistic.id
          ? { ...msg, _error: data.error || "Demo limit reached." }
          : msg));
        if (onDemoBlocked) onDemoBlocked(data.reason, data.error);
        return;
      }

      // Demo: update remaining count if returned
      if (data.demo && onDemoUpdate) {
        onDemoUpdate(data.demo);
      }

      setMessages(m => {
        // Attach any correction back to the user's last message, then append character reply
        const next = m.map(msg => msg.id === optimistic.id && data.correction
          ? { ...msg, kr_corrections: [...(msg.kr_corrections || []), data.correction] }
          : msg);
        if (data.message) next.push(data.message);
        return next;
      });
    } catch (err) {
      console.error("send failed", err);
      setMessages(m => m.map(msg => msg.id === optimistic.id
        ? { ...msg, _error: "Couldn't send — try again." }
        : msg));
    } finally {
      setSending(false);
    }
  };

  const onKeyDown = (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      send();
    }
  };

  const characterName = scenario?.character?.name ?? scenario?.character_name ?? "Noona";
  const charStyle = characterStyle(characterName);

  return (
    <section className="chat-screen">
      <header className="chat-header">
        <div className="chat-header-row">
          <button className="back-btn" onClick={onBack} aria-label="Back to scenarios">←</button>

          <div className="chat-character">
            <Avatar name={characterName} size={40} />
            <div className="chat-character-text">
              <span className="chat-character-name">
                {charStyle.hangul || characterName}
                <span className="chat-character-romaji"> · {characterName}</span>
              </span>
              <span className="chat-character-scene">
                {(scenario?.title_en || scenario?.title || "") + (scenario?.location ? ` — ${scenario.location}` : "")}
              </span>
            </div>
          </div>

          <div className="chat-toggles" role="group" aria-label="Display options">
            <button className="toggle" aria-pressed={showRoman} onClick={() => setShowRoman(v => !v)} title="Show romanization">Aa</button>
            <button className="toggle" aria-pressed={showEn} onClick={() => setShowEn(v => !v)} title="Show English">EN</button>
            <button className="toggle" aria-pressed={showCorrections} onClick={() => setShowCorrections(v => !v)} title="Show Noona's notes">누나</button>
          </div>
        </div>

        {scenario?.description && (
          <div className="chat-scenelet">
            <p className="scenelet">{scenario.description}</p>
          </div>
        )}
      </header>

      <div className="chat-body" ref={scrollerRef}>
        <div className="chat-list">
          {messages.map((m) => (
            <Message
              key={m.id}
              message={m}
              showRoman={showRoman}
              showEn={showEn}
              showCorrections={showCorrections}
              defaultCharacterName={characterName}
            />
          ))}

          {sending && (
            <div className="msg character">
              <Avatar name={characterName} size={36} />
              <div className="typing" aria-label={`${characterName} is thinking`}>
                <span></span><span></span><span></span>
              </div>
            </div>
          )}
        </div>
      </div>

      <div className="chat-input">
        <div className="chat-input-inner">
          <button className="icon-btn" aria-label="Voice (coming soon)" title="Voice (coming soon)" disabled>
            <MicIcon />
          </button>
          <textarea
            ref={textareaRef}
            value={draft}
            onChange={(e) => setDraft(e.target.value)}
            onKeyDown={onKeyDown}
            placeholder="한국어로 답해보세요…   reply in Korean"
            rows={1}
          />
          <button className="icon-btn send-btn" onClick={send} disabled={!draft.trim() || sending} aria-label="Send">
            <SendIcon />
          </button>
        </div>
        <div className="input-foot">
          <span>Enter to send · Shift+Enter for line break</span>
          <span>누나 is listening</span>
        </div>
      </div>
    </section>
  );
}

function Message({ message, showRoman, showEn, showCorrections, defaultCharacterName }) {
  const isUser = message.role === "user";
  const characterName = message.character?.name ?? defaultCharacterName;

  // The Korean to display: characters use content_korean; users see what they typed.
  const koreanText = isUser
    ? (message.user_input || message.content_korean || "")
    : (message.content_korean || "");

  return (
    <div>
      <div className={`msg ${isUser ? "user" : "character"}`}>
        {!isUser && <Avatar name={characterName} size={36} />}
        <div className="bubble">
          {koreanText && <p className="kr">{koreanText}</p>}
          {showRoman && message.content_romanization && (
            <span className="romanization">{message.content_romanization}</span>
          )}
          {showRoman && message.metadata?.pronunciation && (
            <span className="pronunciation">{message.metadata.pronunciation}</span>
          )}
          {showEn && !isUser && message.content_english && (
            <span className="translation">{message.content_english}</span>
          )}
          {message._error && <span className="error-line">{message._error}</span>}
        </div>
      </div>

      {message.metadata?.action && (
        <div className={`action-line ${isUser ? "user" : ""}`}>{message.metadata.action}</div>
      )}

      {showCorrections && message.kr_corrections?.length > 0 &&
        message.kr_corrections.map((c, i) => (
          <Correction key={i} correction={c} side={isUser ? "user" : "character"} />
        ))
      }
    </div>
  );
}

function Correction({ correction, side }) {
  return (
    <div className={`correction ${side}`}>
      <div className="correction-header">
        <span className="correction-sig">a note from Noona</span>
        {correction.severity && (
          <span className="correction-severity">{correction.severity}</span>
        )}
      </div>
      {correction.positive_note && (
        <p className="correction-positive">"{correction.positive_note}"</p>
      )}
      {correction.correct_version_korean && (
        <div className="correction-fix">
          <p className="kr">{correction.correct_version_korean}</p>
          {correction.correct_version_romanization && (
            <span className="romanization">{correction.correct_version_romanization}</span>
          )}
          {correction.correct_version_pronunciation && (
            <span className="pronunciation">{correction.correct_version_pronunciation}</span>
          )}
        </div>
      )}
      {correction.pattern_note && (
        <p className="correction-pattern">
          <strong>pattern</strong>
          {correction.pattern_note}
        </p>
      )}
    </div>
  );
}

/* ============================================================ *
 * Loading curtain between picker and chat
 * ============================================================ */
function ChatLoadingCurtain({ scenario }) {
  return (
    <div className="curtain">
      <div className="curtain-inner">
        <span className="eyebrow">Stepping inside</span>
        <h2 className="curtain-title hangul">{scenario?.title_kr ?? scenario?.title ?? "잠시만요…"}</h2>
        <div className="typing" aria-label="loading">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  );
}

/* ============================================================ *
 * Avatar — colored disc with initial, falls back from <img>.
 * ============================================================ */
function Avatar({ name, size = 36 }) {
  const [imgOk, setImgOk] = useState(true);
  const style = characterStyle(name);
  const slug = characterSlug(name);
  return (
    <span
      className="avatar"
      style={{
        width: size,
        height: size,
        fontSize: Math.round(size * 0.45),
        background: style.color,
      }}
      aria-label={`${name} avatar`}
    >
      {imgOk
        ? <img src={`/characters/${slug}.png`} alt="" onError={() => setImgOk(false)} />
        : style.initial}
    </span>
  );
}

/* ------------------------------------------------------------ *
 * Tiny helpers
 * ------------------------------------------------------------ */
function readPref(key, fallback) {
  try {
    const raw = localStorage.getItem(`noonasays.${key}`);
    return raw === null ? fallback : JSON.parse(raw);
  } catch { return fallback; }
}
function writePref(key, value) {
  try { localStorage.setItem(`noonasays.${key}`, JSON.stringify(value)); } catch {}
}

function MicIcon() {
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round">
      <rect x="9" y="3" width="6" height="12" rx="3" />
      <path d="M5 11a7 7 0 0 0 14 0" />
      <line x1="12" y1="18" x2="12" y2="21" />
      <line x1="9" y1="21" x2="15" y2="21" />
    </svg>
  );
}
function SendIcon() {
  return (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round">
      <path d="M5 12l14-7-5 14-3-6-6-1z" />
    </svg>
  );
}


/* ============================================================ *
 * Lesson Screen - Noona prepares you before the scenario
 * ============================================================ */
function LessonScreen({ scenario, onStartChat, onBack }) {
  const [lesson, setLesson] = useState(null);
  const [loading, setLoading] = useState(true);
  const [regenerating, setRegenerating] = useState(false);
  const [error, setError] = useState(null);

  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    authFetch(`${API_BASE}/lesson/${scenario.id}`)
      .then(r => r.json())
      .then(data => {
        if (cancelled) return;
        setLesson(data.lesson);
        setLoading(false);
      })
      .catch(err => {
        if (cancelled) return;
        console.error("lesson fetch failed", err);
        setError("Couldn't load the lesson. Try again?");
        setLoading(false);
      });
    return () => { cancelled = true; };
  }, [scenario.id]);

  const regenerate = async () => {
    setRegenerating(true);
    try {
      const res = await authFetch(`${API_BASE}/lesson/${scenario.id}/regenerate`, {
        method: "POST",
      });
      const data = await res.json();
      setLesson(data.lesson);
    } catch (err) {
      console.error("regenerate failed", err);
    }
