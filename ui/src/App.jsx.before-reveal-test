function HangulLesson({ seqOrder, onBack, onComplete }) {
  const [lesson, setLesson] = useState(null);
  const [loading, setLoading] = useState(true);
  const [currentSection, setCurrentSection] = useState(0);
  const [audioPlaying, setAudioPlaying] = useState(null);
  const [practiceState, setPracticeState] = useState({});

  useEffect(() => {
    authFetch(`${API_BASE}/hangul/lessons/${seqOrder}`)
      .then(r => r.json())
      .then(data => {
        setLesson(data.lesson);
        setLoading(false);
      })
      .catch(err => {
        console.error("hangul lesson failed", err);
        setLoading(false);
      });
  }, [seqOrder]);

  const playLetterAudio = async (letter) => {
    setAudioPlaying(letter);
    try {
      const res = await authFetch(`${API_BASE}/hangul/letter/${encodeURIComponent(letter)}/audio`);
      const data = await res.json();
      if (data.audio_base64) {
        const audio = new Audio(`data:audio/mpeg;base64,${data.audio_base64}`);
        audio.onended = () => setAudioPlaying(null);
        audio.play();
      } else {
        setAudioPlaying(null);
      }
    } catch (err) {
      console.error("audio failed", err);
      setAudioPlaying(null);
    }
  };

  const markComplete = async () => {
    await authFetch(`${API_BASE}/hangul/complete/${seqOrder}`, { method: 'POST' });
    onComplete();
  };

  if (loading) {
    return (
      <div className="hangul-list-loading">
        <div className="auth-loading-disc">한</div>
      </div>
    );
  }

  if (!lesson) {
    return (
      <div className="hangul-list-loading">
        <p>Lesson not found.</p>
        <button onClick={onBack}>Back</button>
      </div>
    );
  }

  const sections = lesson.content?.sections || [];
  const section = sections[currentSection];
  const isLast = currentSection === sections.length - 1;

  return (
    <div className="hangul-lesson-screen">
      <header className="hangul-lesson-header">
        <button className="back-btn" onClick={onBack}>← lessons</button>
        <div className="hangul-lesson-progress">
          {sections.map((_, i) => (
            <div 
              key={i} 
              className={`progress-dot ${i === currentSection ? 'current' : ''} ${i < currentSection ? 'done' : ''}`}
            />
          ))}
        </div>
        <div style={{ width: 100 }} />
      </header>

      <div className="hangul-lesson-content">
        <div className="hangul-lesson-meta-top">
          <div className="hangul-lesson-eyebrow">lesson {seqOrder} · {lesson.title}</div>
        </div>

        {section?.type === 'story' && (
          <section className="hangul-section story">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
          </section>
        )}

        {section?.type === 'concept' && (
          <section className="hangul-section concept">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
            {section.example && (
              <div className="hangul-example-box">
                <div className="hangul-example-korean">{section.example.korean}</div>
                <div className="hangul-example-rom">{section.example.romanization}</div>
                <div className="hangul-example-eng">{section.example.english}</div>
                {section.example.breakdown && (
                  <div className="hangul-example-breakdown">{section.example.breakdown}</div>
                )}
                {section.example.korean && section.example.korean.length >= 1 && (
                  <div className="hangul-example-audio">
                    <WordAudioButton word={section.example.korean} />
                  </div>
                )}
              </div>
            )}
          </section>
        )}

        {section?.type === 'letter' && (
          <section className="hangul-section letter">
            <div className="hangul-letter-display">
              <div className="hangul-letter-char">{section.letter}</div>
              <button 
                className={`hangul-letter-audio ${audioPlaying === section.letter ? 'playing' : ''}`}
                onClick={() => playLetterAudio(section.letter)}
              >
                {audioPlaying === section.letter ? '♪ playing' : '♪ hear it'}
              </button>
              {section.letter_type === 'consonant' && section.letter !== 'ㅇ' && (
                <div className="consonant-note">
                  Korean consonants ride on the vowel that follows. Listen for the <em>start</em> of the syllable — that's the consonant.
                </div>
              )}
            </div>
            <div className="hangul-letter-info">
              <div className="hangul-letter-rom">{section.romanization}</div>
              <div className="hangul-letter-sound">{section.sound_description}</div>
            </div>
            {section.pronunciation_tip && (
              <div className="hangul-letter-tip">
                <span className="tip-label">tip</span>
                {section.pronunciation_tip}
              </div>
            )}
            {section.callout && (
              <div className="hangul-letter-callout">
                {section.callout}
              </div>
            )}
          </section>
        )}

        {section?.type === 'recognition' && (
          <section className="hangul-section recognition">
            <h2>{section.title}</h2>
            <p className="recognition-prompt">{section.prompt}</p>
            <div className="recognition-options">
              {section.options.map((opt, i) => {
                const state = practiceState[currentSection];
                const selected = state?.selected === i;
                const correct = state?.correct;
                return (
                  <button
                    key={i}
                    className={`recognition-option ${selected ? 'selected' : ''} ${selected && correct ? 'correct' : ''} ${selected && !correct ? 'wrong' : ''}`}
                    onClick={() => {
                      const isCorrect = i === section.correct_index;
                      setPracticeState(prev => ({
                        ...prev,
                        [currentSection]: { selected: i, correct: isCorrect, done: isCorrect }
