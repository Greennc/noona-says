* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body, #root {
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  background: #f7f2ec;
  color: #2a2520;
  overflow: hidden;
}

/* ============================================
   WELCOME / SCENARIO PICKER
   ============================================ */
.welcome {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
  overflow-y: auto;
}
.welcome-inner {
  max-width: 600px;
  width: 100%;
}
.welcome h1 {
  font-size: 3rem;
  font-weight: 300;
  letter-spacing: -0.02em;
  text-align: center;
  color: #6b4423;
}
.welcome .tagline {
  text-align: center;
  margin: 0.5rem 0 3rem;
  color: #8a7560;
  font-size: 1.1rem;
}
.welcome h2 {
  font-size: 0.9rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 1rem;
  color: #8a7560;
}
.scenario-card {
  background: white;
  border: 1px solid #e5dcd0;
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 1rem;
  cursor: pointer;
  transition: all 0.15s;
}
.scenario-card:hover {
  border-color: #c9a779;
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(107, 68, 35, 0.08);
}
.scenario-title {
  font-size: 1.2rem;
  font-weight: 600;
  color: #2a2520;
  margin-bottom: 0.25rem;
}
.scenario-location {
  font-size: 0.85rem;
  color: #8a7560;
  margin-bottom: 0.75rem;
}
.scenario-desc {
  font-size: 0.95rem;
  color: #5a4a3a;
  line-height: 1.5;
}

/* ============================================
   MAIN APP
   ============================================ */
.app {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 1.5rem;
  background: white;
  border-bottom: 1px solid #e5dcd0;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.reset-btn {
  background: none;
  border: none;
  color: #6b4423;
  cursor: pointer;
  font-size: 0.9rem;
  padding: 0.5rem 0.75rem;
  border-radius: 6px;
}
.reset-btn:hover {
  background: #f7f2ec;
}
.header-title {
  font-weight: 600;
  color: #2a2520;
}
.toggles {
  display: flex;
  gap: 1rem;
  font-size: 0.85rem;
  color: #5a4a3a;
}
.toggles label {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  cursor: pointer;
}

main {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ============================================
   CHAT MESSAGES
   ============================================ */
.chat {
  flex: 1;
  overflow-y: auto;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.message {
  display: flex;
}
.message.user {
  justify-content: flex-end;
}
.message.assistant {
  justify-content: flex-start;
}

.bubble {
  max-width: 75%;
  padding: 1rem 1.25rem;
  border-radius: 16px;
  line-height: 1.5;
}
.assistant-bubble {
  background: white;
  border: 1px solid #e5dcd0;
  border-bottom-left-radius: 4px;
}
.user-bubble {
  background: #6b4423;
  color: white;
  border-bottom-right-radius: 4px;
}

.korean {
  font-size: 1.35rem;
  font-weight: 500;
  color: #2a2520;
  margin-bottom: 0.4rem;
}
.romanization {
  font-size: 0.95rem;
  font-style: italic;
  color: #8a7560;
  margin-bottom: 0.4rem;
}
.english {
  font-size: 0.95rem;
  color: #5a4a3a;
}
.action {
  font-size: 0.85rem;
  color: #a89580;
  font-style: italic;
  margin-top: 0.5rem;
}

.user-text {
  font-size: 1rem;
}

/* ============================================
   CORRECTIONS (NOONA)
   ============================================ */
.correction {
  margin-top: 0.75rem;
  padding: 0.85rem;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 10px;
  font-size: 0.9rem;
  color: white;
}
.correction-header {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  opacity: 0.7;
  margin-bottom: 0.5rem;
}
.positive {
  margin-bottom: 0.5rem;
  color: #ffe9c2;
}
.suggestion {
  background: rgba(255, 255, 255, 0.1);
  padding: 0.6rem 0.75rem;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}
.suggestion-korean {
  font-size: 1.1rem;
  font-weight: 500;
  margin-bottom: 0.15rem;
}
.suggestion-rom {
  font-size: 0.85rem;
  font-style: italic;
  opacity: 0.85;
}
.pattern {
  font-size: 0.85rem;
  opacity: 0.9;
  line-height: 1.4;
}

/* ============================================
   LOADING
   ============================================ */
.loading {
  padding: 1rem 1.25rem;
}
.dots {
  display: flex;
  gap: 0.3rem;
  font-size: 1.5rem;
  line-height: 1;
}
.dots span {
  animation: pulse 1.2s ease-in-out infinite;
  color: #c9a779;
}
.dots span:nth-child(2) { animation-delay: 0.2s; }
.dots span:nth-child(3) { animation-delay: 0.4s; }
@keyframes pulse {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

/* ============================================
   INPUT AREA
   ============================================ */
.input-area {
  padding: 1rem 1.5rem;
  background: white;
  border-top: 1px solid #e5dcd0;
  display: flex;
  gap: 0.75rem;
  align-items: flex-end;
}
textarea {
  flex: 1;
  padding: 0.75rem 1rem;
  border: 1px solid #e5dcd0;
  border-radius: 12px;
  font-family: inherit;
  font-size: 1rem;
  resize: none;
  background: #faf6f0;
}
textarea:focus {
  outline: none;
  border-color: #c9a779;
  background: white;
}
textarea:disabled {
  opacity: 0.6;
}
button:not(.reset-btn) {
  padding: 0.75rem 1.5rem;
  background: #6b4423;
  color: white;
  border: none;
  border-radius: 12px;
  font-size: 1rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
}
button:not(.reset-btn):hover:not(:disabled) {
  background: #5a3a1d;
}
button:not(.reset-btn):disabled {
  background: #c9a779;
  cursor: not-allowed;
  opacity: 0.7;
}
