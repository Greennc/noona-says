app.get('/conversation/:id', async (req, res) => {
  try {
    const { data: messages, error } = await supabase
      .from('kr_messages')
      .select('*, kr_corrections(*)')
      .eq('conversation_id', req.params.id)
      .order('created_at', { ascending: true });
