/* =================================================================
   noona says — index.css
   "Quiet Seoul journal" design system

   Drop this in alongside App.jsx. Loads Newsreader + Noto Serif KR +
   Pretendard + JetBrains Mono from Google Fonts and jsDelivr.
   ================================================================= */

@import url("https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500;600;700;900&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=JetBrains+Mono:wght@400;500&display=swap");
@import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css");

:root {
  /* paper & ink */
  --paper:       #F4ECE0;
  --paper-soft:  #EFE5D5;
  --paper-deep:  #E7DAC3;
  --ink:         #2A211A;
  --ink-soft:    #5A4133;
  --ink-faint:   #8C7860;
  --ink-mute:    #B6A48A;
  --rule:        #D8C9B0;

  /* accents */
  --persimmon:      #C56A4A;
  --persimmon-deep: #A8533A;
  --sage:           #8A9B7C;
  --rose:           #C8927D;
  --peach:          #E6BFA3;
  --walnut:         #5A4133;

  /* character disc tones */
  --noona: #E6BFA3;
  --minji: #D8A9A0;
  --taxi:  #B5A88A;
  --bar:   #9A8CA0;
  --host:  #C9B98F;

  /* type */
  --serif:  "Newsreader", "Noto Serif KR", Georgia, serif;
  --hangul: "Noto Serif KR", "Newsreader", serif;
  --sans:   "Pretendard", "Pretendard Variable", -apple-system, BlinkMacSystemFont, sans-serif;
  --mono:   "JetBrains Mono", ui-monospace, monospace;

  --shadow-card: 0 1px 0 rgba(90,65,51,0.04), 0 12px 32px -18px rgba(60,40,25,0.22);
  --shadow-soft: 0 1px 2px rgba(60,40,25,0.06), 0 8px 24px -16px rgba(60,40,25,0.20);
}

/* Warm dark mode — opt in by setting <html data-theme="dark"> */
html[data-theme="dark"] {
  --paper:      #1F1814;
  --paper-soft: #261D17;
  --paper-deep: #2E241D;
  --ink:        #F1E6D6;
  --ink-soft:   #D6C5AE;
  --ink-faint:  #A99478;
  --ink-mute:   #806C56;
  --rule:       #3A2E25;

  --shadow-card: 0 1px 0 rgba(0,0,0,0.3), 0 16px 36px -20px rgba(0,0,0,0.6);
}

/* -------------------- reset -------------------- */
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
html, body, #root { min-height: 100dvh; }
body {
  font-family: var(--sans);
  color: var(--ink);
  background: var(--paper);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: -0.005em;
  font-feature-settings: "ss01", "ss02", "tnum";
}
button { font-family: inherit; }

/* paper grain — extremely subtle */
body::before {
  content: "";
  position: fixed; inset: 0;
  pointer-events: none;
  background-image:
    radial-gradient(rgba(90,65,51,0.045) 1px, transparent 1px),
    radial-gradient(rgba(90,65,51,0.025) 1px, transparent 1px);
  background-size: 3px 3px, 7px 7px;
  background-position: 0 0, 1px 2px;
  opacity: 0.6;
  mix-blend-mode: multiply;
  z-index: 100;
}
html[data-theme="dark"] body::before { display: none; }

/* -------------------- atoms -------------------- */
.stage { max-width: 880px; margin: 0 auto; padding: 0 24px; }
.hangul { font-family: var(--hangul); letter-spacing: -0.01em; }
.serif  { font-family: var(--serif); }
.mono   { font-family: var(--mono); letter-spacing: 0; }

.eyebrow {
  font-family: var(--mono);
  font-size: 11px; font-weight: 500;
  letter-spacing: 0.18em; text-transform: uppercase;
  color: var(--ink-faint);
}

.notice {
  margin: 12px 0;
  padding: 10px 14px;
  border: 1px solid var(--persimmon);
  background: rgba(197,106,74,0.08);
  border-radius: 6px;
  color: var(--persimmon-deep);
  font-family: var(--serif);
  font-style: italic;
  font-size: 14px;
}

/* avatars */
.avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: var(--peach);
  color: var(--ink);
  font-family: var(--hangul);
  font-weight: 600;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  box-shadow: inset 0 0 0 1px rgba(42,33,26,0.06);
}
.avatar img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
}

/* -------------------- shell -------------------- */
.app-shell { min-height: 100dvh; position: relative; }

/* ================================================================
   SCENARIO PICKER
   ================================================================ */
.picker { padding: 56px 0 96px; animation: rise 0.5s 0.05s both ease-out; }

.picker-head {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: end;
  gap: 24px;
  padding-bottom: 28px;
  border-bottom: 1px solid var(--rule);
}
.brand { display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin: 0; }
.brand-mark {
  font-family: var(--hangul);
  font-size: 64px; line-height: 0.9;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.02em;
}
.brand-mark .says {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  color: var(--persimmon);
}
.brand-hangul {
  font-family: var(--hangul);
  font-size: 14px; font-weight: 500;
  color: var(--ink-soft);
}
.brand-sub {
  display: block;
  margin-top: 10px;
  color: var(--ink-faint);
  font-size: 14px;
  max-width: 38ch;
  line-height: 1.5;
}

.weather-strip {
  text-align: right;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-faint);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  line-height: 1.6;
}
.weather-strip strong {
  display: block;
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  font-size: 22px;
  color: var(--ink);
  letter-spacing: 0;
  text-transform: none;
  margin-bottom: 4px;
}

.section-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 44px 0 18px;
}
.section-label h2 {
  margin: 0;
  font-family: var(--serif);
  font-weight: 400; font-style: italic;
  font-size: 22px;
  color: var(--ink);
}
.section-label .count {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-faint);
  letter-spacing: 0.15em;
}

/* card grid */
.cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; }
@media (max-width: 680px) { .cards { grid-template-columns: 1fr; } }

.card {
  appearance: none;
  text-align: left;
  border: 1px solid var(--rule);
  background: var(--paper-soft);
  border-radius: 4px;
  padding: 22px 22px 20px;
  cursor: pointer;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18px;
  transition: transform .25s ease, box-shadow .25s ease, background .25s ease;
  font-family: inherit;
  color: inherit;
  overflow: hidden;
  animation: rise 0.5s both ease-out;
}
.card::before {
  content: "";
  position: absolute; top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(180deg, rgba(90,65,51,0.08), transparent);
}
.card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-card);
  background: #F8F1E4;
}
html[data-theme="dark"] .card:hover { background: #2A211A; }
.card:focus-visible { outline: 2px solid var(--persimmon); outline-offset: 2px; }

.card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
.card-meta { display: flex; flex-direction: column; gap: 8px; flex: 1; min-width: 0; }
.card-location {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--mono);
  font-size: 11px; color: var(--ink-faint);
  letter-spacing: 0.15em; text-transform: uppercase;
}
.card-location::before {
  content: "";
  width: 5px; height: 5px;
  border-radius: 50%;
  background: var(--persimmon);
}
.card-title {
  margin: 0;
  font-family: var(--hangul);
  font-weight: 600;
  font-size: 26px;
  line-height: 1.15;
  color: var(--ink);
}
.card-title-en {
  display: block;
  font-family: var(--serif);
  font-style: italic; font-weight: 400;
  font-size: 15px;
  color: var(--ink-soft);
  margin-top: 4px;
  letter-spacing: 0;
}

/* postage-stamp character corner */
.card-stamp {
  width: 76px; height: 92px;
  background: var(--paper);
  border: 1px solid var(--rule);
  border-radius: 2px;
  padding: 8px 6px 6px;
  display: flex; flex-direction: column;
  align-items: center; gap: 6px;
  position: relative; flex-shrink: 0;
}
.card-stamp::after {
  content: "";
  position: absolute; inset: -3px;
  border: 1px dashed var(--rule);
  border-radius: 4px;
  pointer-events: none;
  opacity: 0.5;
}
.card-stamp .stamp-name {
  font-family: var(--serif);
  font-style: italic;
  font-size: 11px;
  color: var(--ink-soft);
  line-height: 1;
}

.card-body {
  font-family: var(--serif);
  font-size: 15px;
  line-height: 1.55;
  color: var(--ink-soft);
  margin: 0;
  text-wrap: pretty;
}

.card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 14px;
  border-top: 1px dashed var(--rule);
}

.difficulty {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-faint);
}
.diff-pips { display: inline-flex; gap: 3px; }
.diff-pips span { width: 6px; height: 6px; border-radius: 50%; background: var(--rule); }
.diff-pips span.on { background: var(--persimmon); }

.card-cta {
  font-family: var(--serif);
  font-style: italic;
  font-size: 13px;
  color: var(--ink);
  display: inline-flex; align-items: center; gap: 6px;
}
.card-cta::after {
  content: "→";
  font-family: var(--sans);
  font-style: normal;
  transition: transform .25s ease;
}
.card:hover .card-cta::after { transform: translateX(3px); }

.card-corner {
  position: absolute;
  bottom: 10px; right: 14px;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.1em;
}

.picker-foot {
  margin-top: 56px;
  padding-top: 24px;
  border-top: 1px solid var(--rule);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-family: var(--mono);
  font-size: 11px;
  color: var(--ink-faint);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* skeleton */
.card.skeleton { pointer-events: none; min-height: 200px; gap: 14px; }
.sk-line {
  height: 12px;
  background: linear-gradient(90deg, var(--paper-deep), var(--paper-soft), var(--paper-deep));
  background-size: 200% 100%;
  animation: shimmer 1.4s linear infinite;
  border-radius: 3px;
}
.sk-line.lg { height: 28px; }
.sk-line.w60 { width: 60%; } .sk-line.w70 { width: 70%; }
.sk-line.w90 { width: 90%; } .sk-line.w95 { width: 95%; }

@keyframes shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* ================================================================
   CURTAIN (transition while starting conversation)
   ================================================================ */
.curtain {
  min-height: 100dvh;
  display: grid; place-items: center;
  padding: 24px;
  animation: rise 0.4s both ease-out;
}
.curtain-inner {
  text-align: center;
  display: flex; flex-direction: column;
  align-items: center; gap: 18px;
}
.curtain-title {
  font-family: var(--hangul);
  font-size: 40px;
  font-weight: 600;
  margin: 0;
  color: var(--ink);
}

/* ================================================================
   CHAT
   ================================================================ */
.chat-screen {
  height: 100dvh;
  display: flex; flex-direction: column;
  background: var(--paper);
  animation: rise 0.45s both ease-out;
}

.chat-header {
  position: sticky; top: 0;
  z-index: 30;
  background: color-mix(in oklab, var(--paper) 92%, transparent);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--rule);
  padding: 14px 22px 12px;
}
.chat-header-row {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 16px;
  align-items: center;
  max-width: 880px;
  margin: 0 auto;
}

.back-btn {
  appearance: none;
  border: 1px solid var(--rule);
  background: var(--paper-soft);
  width: 36px; height: 36px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center; justify-content: center;
  cursor: pointer;
  color: var(--ink);
  font-family: var(--serif);
  font-size: 18px;
  transition: background .2s;
}
.back-btn:hover { background: var(--paper-deep); }

.chat-character { display: flex; align-items: center; gap: 12px; min-width: 0; }
.chat-character-text { display: flex; flex-direction: column; line-height: 1.1; min-width: 0; }
.chat-character-name {
  font-family: var(--hangul);
  font-weight: 600;
  font-size: 17px;
  color: var(--ink);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.chat-character-romaji {
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  color: var(--ink-soft);
  font-size: 14px;
}
.chat-character-scene {
  font-family: var(--serif);
  font-style: italic;
  font-size: 12px;
  color: var(--ink-faint);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

.chat-toggles {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px;
  background: var(--paper-soft);
  border: 1px solid var(--rule);
  border-radius: 999px;
}
.toggle {
  appearance: none;
  border: 0;
  background: transparent;
  cursor: pointer;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 6px 10px;
  border-radius: 999px;
  color: var(--ink-faint);
  transition: background .2s, color .2s;
}
.toggle[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
.toggle:hover:not([aria-pressed="true"]) { color: var(--ink); }

.chat-scenelet {
  max-width: 880px;
  margin: 0 auto;
  padding: 14px 0 0;
}
.scenelet {
  border-left: 2px solid var(--persimmon);
  padding: 4px 0 4px 14px;
  margin: 0;
  font-family: var(--serif);
  font-style: italic;
  font-size: 14px;
  color: var(--ink-soft);
  line-height: 1.5;
}

.chat-body { flex: 1; overflow-y: auto; padding: 18px 22px 24px; }
.chat-list {
  max-width: 880px;
  margin: 0 auto;
  display: flex; flex-direction: column;
  gap: 22px;
}

.msg {
  display: flex; gap: 12px;
  align-items: flex-start;
  animation: rise 0.4s both ease-out;
}
.msg.user { justify-content: flex-end; }
.msg.character .avatar { width: 36px; height: 36px; font-size: 16px; margin-top: 2px; }

.bubble {
  max-width: 78%;
  background: var(--paper-soft);
  border: 1px solid var(--rule);
  border-radius: 14px 14px 14px 4px;
  padding: 14px 16px;
  position: relative;
}
.msg.user .bubble {
  background: var(--ink);
  color: var(--paper);
  border: 1px solid var(--ink);
  border-radius: 14px 14px 4px 14px;
}

.kr {
  font-family: var(--hangul);
  font-weight: 500;
  font-size: 20px;
  line-height: 1.45;
  color: var(--ink);
  margin: 0;
  letter-spacing: -0.01em;
}
.msg.user .kr { color: var(--paper); }

.romanization {
  display: block;
  margin-top: 6px;
  font-family: var(--serif);
  font-style: italic;
  font-size: 13px;
  color: var(--ink-faint);
  line-height: 1.4;
}
.msg.user .romanization { color: rgba(244,236,224,0.62); }

.translation {
  display: block;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px dashed var(--rule);
  font-size: 12.5px;
  line-height: 1.55;
  color: var(--ink-faint);
}

.action-line {
  margin: 8px 0 0 48px;
  font-family: var(--serif);
  font-style: italic;
  font-size: 13px;
  color: var(--ink-faint);
  line-height: 1.5;
}
.action-line::before { content: "✻ "; color: var(--ink-mute); }
.action-line.user { margin: 8px 48px 0 0; text-align: right; }

.error-line {
  display: block;
  margin-top: 6px;
  font-family: var(--mono);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--persimmon-deep);
}

/* Correction — sticky note */
.correction {
  margin-top: 10px;
  margin-left: 48px;
  background: linear-gradient(180deg, #FBE9D2, #F6DDBE);
  border: 1px solid #E0BE96;
  border-radius: 3px;
  padding: 14px 16px 12px;
  position: relative;
  box-shadow: 1px 2px 0 rgba(90,65,51,0.06), 6px 14px 22px -16px rgba(90,65,51,0.5);
  transform: rotate(-0.6deg);
  max-width: 78%;
  animation: rise 0.45s 0.1s both ease-out;
}
.correction.user {
  margin-left: auto;
  margin-right: 0;
  transform: rotate(0.4deg);
}
.correction::before {
  content: "";
  position: absolute;
  top: -8px; left: 50%;
  transform: translateX(-50%) rotate(-2deg);
  width: 56px; height: 14px;
  background: rgba(197,106,74,0.18);
  border-left: 1px dashed rgba(197,106,74,0.3);
  border-right: 1px dashed rgba(197,106,74,0.3);
}
.correction-header {
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 8px;
}
.correction-sig {
  font-family: var(--serif);
  font-style: italic;
  font-size: 12px;
  color: var(--persimmon-deep);
}
.correction-sig::before { content: "♡ "; font-style: normal; }
.correction-severity {
  font-family: var(--mono);
  font-size: 9px;
  color: var(--persimmon-deep);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-left: auto;
  opacity: 0.7;
}
.correction-positive {
  margin: 0 0 10px;
  font-family: var(--serif);
  font-size: 14px; font-style: italic;
  color: var(--ink);
  line-height: 1.5;
}
.correction-fix {
  background: rgba(255,255,255,0.5);
  border: 1px dashed rgba(168,83,58,0.35);
  border-radius: 4px;
  padding: 10px 12px;
  margin-bottom: 10px;
}
.correction-fix .kr { font-size: 17px; color: var(--ink); }
.correction-fix .romanization { color: var(--persimmon-deep); }
.correction-pattern {
  font-size: 12px;
  color: var(--ink-soft);
  line-height: 1.55;
  margin: 0;
}
.correction-pattern strong {
  font-family: var(--mono);
  font-weight: 500;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--persimmon-deep);
  display: inline-block;
  margin-right: 6px;
}

/* Typing indicator */
.typing {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 14px 16px;
  background: var(--paper-soft);
  border: 1px solid var(--rule);
  border-radius: 14px 14px 14px 4px;
}
.typing span {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--persimmon);
  opacity: 0.45;
  animation: breathe 1.2s ease-in-out infinite;
}
.typing span:nth-child(2) { animation-delay: 0.18s; }
.typing span:nth-child(3) { animation-delay: 0.36s; }

@keyframes breathe {
  0%, 100% { transform: translateY(0); opacity: 0.35; }
  50%      { transform: translateY(-3px); opacity: 1; }
}
@keyframes rise {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* input */
.chat-input {
  position: sticky;
  bottom: 0;
  background: linear-gradient(180deg,
    color-mix(in oklab, var(--paper) 0%, transparent) 0%,
    color-mix(in oklab, var(--paper) 95%, transparent) 30%,
    var(--paper) 60%);
  padding: 18px 22px 22px;
}
.chat-input-inner {
  max-width: 880px;
  margin: 0 auto;
  display: flex;
  align-items: flex-end;
  gap: 10px;
  background: var(--paper-soft);
  border: 1px solid var(--rule);
  border-radius: 16px;
  padding: 10px 12px;
  transition: border-color .2s, box-shadow .2s;
}
.chat-input-inner:focus-within {
  border-color: var(--persimmon);
  box-shadow: 0 0 0 3px rgba(197,106,74,0.12);
}
.chat-input textarea {
  flex: 1;
  resize: none;
  border: 0;
  background: transparent;
  font-family: var(--hangul);
  font-size: 16px;
  line-height: 1.5;
  color: var(--ink);
  padding: 8px 6px;
  max-height: 140px;
  min-height: 24px;
  outline: 0;
}
.chat-input textarea::placeholder {
  color: var(--ink-mute);
  font-family: var(--serif);
  font-style: italic;
}
.icon-btn {
  appearance: none;
  border: 0;
  background: transparent;
  width: 38px; height: 38px;
  border-radius: 999px;
  cursor: pointer;
  display: inline-flex;
  align-items: center; justify-content: center;
  color: var(--ink-soft);
  transition: background .2s, color .2s;
}
.icon-btn:hover:not([disabled]) { background: var(--paper-deep); color: var(--ink); }
.icon-btn[disabled] { opacity: 0.5; cursor: not-allowed; }
.send-btn { background: var(--ink); color: var(--paper); }
.send-btn:hover:not([disabled]) { background: var(--persimmon-deep); color: var(--paper); }
.send-btn[disabled] { background: var(--paper-deep); color: var(--ink-mute); }

.input-foot {
  max-width: 880px;
  margin: 6px auto 0;
  padding: 0 4px;
  display: flex;
  justify-content: space-between;
  font-family: var(--mono);
  font-size: 10px;
  color: var(--ink-mute);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* mobile */
@media (max-width: 600px) {
  .stage { padding: 0 16px; }
  .brand-mark { font-size: 48px; }
  .picker-head { grid-template-columns: 1fr; }
  .weather-strip { text-align: left; }
  .chat-header { padding: 12px 14px; }
  .chat-toggles { display: none; }
  .chat-body { padding: 14px 14px 12px; }
  .chat-input { padding: 14px 14px 18px; }
  .bubble { max-width: 86%; }
  .correction { margin-left: 0; max-width: 100%; }
  .card-title { font-size: 22px; }
}

/* ============================================================
   LESSON MODE - Noona's pre-scenario briefing
   ============================================================ */

.lesson-loading {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper);
}

.lesson-loading-inner {
  text-align: center;
}

.lesson-loading-disc {
  display: flex;
  justify-content: center;
  margin-bottom: 1.5rem;
}

.lesson-loading-disc .noona-disc {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--hangul);
  font-size: 2rem;
  font-weight: 600;
  color: var(--ink);
  animation: gentle-pulse 2s ease-in-out infinite;
}

@keyframes gentle-pulse {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.05); opacity: 1; }
}

.lesson-loading-text {
  font-family: var(--serif);
  font-size: 1.2rem;
  color: var(--ink-soft);
  margin-bottom: 0.4rem;
}

.lesson-loading-sub {
  font-family: var(--hangul);
  font-size: 0.95rem;
  color: var(--ink-faint);
  font-style: italic;
}

.lesson-error {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
  background: var(--paper);
}

.lesson-error button {
  padding: 0.75rem 1.5rem;
  background: var(--persimmon);
  color: white;
  border: none;
  border-radius: 8px;
  font-family: var(--body);
  font-size: 0.95rem;
  cursor: pointer;
}

.lesson-screen {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  flex-direction: column;
}

.lesson-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 2rem;
  border-bottom: 1px solid var(--rule);
  background: var(--paper-soft);
  position: sticky;
  top: 0;
  z-index: 10;
}

.lesson-header .back-btn,
.lesson-header .skip-btn {
  background: none;
  border: none;
  color: var(--ink-soft);
  font-family: var(--body);
  font-size: 0.9rem;
  cursor: pointer;
  padding: 0.5rem 0.75rem;
  border-radius: 6px;
  transition: background 0.15s;
}

.lesson-header .back-btn:hover,
.lesson-header .skip-btn:hover {
  background: var(--paper-deep);
}

.lesson-header-title {
  text-align: center;
  flex: 1;
}

.lesson-eyebrow {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-faint);
  margin-bottom: 0.3rem;
}

.lesson-header-title h1 {
  font-family: var(--serif);
  font-size: 1.4rem;
  font-weight: 500;
  color: var(--ink);
  margin: 0;
}

.lesson-body {
  max-width: 720px;
  margin: 0 auto;
  padding: 2.5rem 2rem 4rem;
  width: 100%;
}

.lesson-intro,
.lesson-closing {
  display: flex;
  gap: 1.25rem;
  align-items: flex-start;
  margin-bottom: 2.5rem;
  padding: 1.5rem;
  background: var(--paper-soft);
  border-radius: 16px;
  border: 1px solid var(--rule);
}

.lesson-closing {
  margin-top: 2.5rem;
  margin-bottom: 1.5rem;
}

.lesson-intro-avatar .noona-disc {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--hangul);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--ink);
  flex-shrink: 0;
}

.lesson-intro-text {
  flex: 1;
}

.lesson-speaker {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-faint);
  margin-bottom: 0.5rem;
}

.lesson-intro-text p {
  font-family: var(--serif);
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--ink-soft);
  margin: 0;
}

.lesson-section {
  margin-bottom: 2.5rem;
}

.lesson-section-title {
  font-family: var(--serif);
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 1.25rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--rule);
}

/* Vocab cards */
.vocab-cards {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1rem;
}

.vocab-card {
  background: white;
  border: 1px solid var(--rule);
  border-radius: 12px;
  padding: 1.25rem;
  transition: transform 0.15s, box-shadow 0.15s;
}

.vocab-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(90, 65, 51, 0.06);
  border-color: var(--peach);
}

.vocab-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 0.35rem;
  gap: 0.75rem;
}

.vocab-korean {
  font-family: var(--hangul);
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--ink);
}

.vocab-romanization {
  font-family: var(--serif);
  font-style: italic;
  font-size: 0.9rem;
  color: var(--ink-faint);
}

.vocab-english {
  font-family: var(--body);
  font-size: 0.95rem;
  color: var(--ink-soft);
  margin-bottom: 0.75rem;
}

.vocab-example {
  padding: 0.65rem 0.75rem;
  background: var(--paper);
  border-radius: 8px;
  margin-bottom: 0.75rem;
}

.vocab-example-korean {
  font-family: var(--hangul);
  font-size: 1rem;
  color: var(--ink);
  margin-bottom: 0.2rem;
}

.vocab-example-rom {
  font-family: var(--serif);
  font-style: italic;
  font-size: 0.8rem;
  color: var(--ink-faint);
  margin-bottom: 0.15rem;
}

.vocab-example-eng {
  font-family: var(--body);
  font-size: 0.85rem;
  color: var(--ink-mute);
}

.vocab-tip {
  font-family: var(--body);
  font-size: 0.85rem;
  color: var(--ink-soft);
  line-height: 1.5;
  padding-top: 0.5rem;
  border-top: 1px dashed var(--rule);
}

.vocab-tip-label {
  font-family: var(--mono);
  text-transform: uppercase;
  font-size: 0.7rem;
  letter-spacing: 0.08em;
  color: var(--persimmon);
}

/* Grammar cards */
.grammar-cards {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.grammar-card {
  background: white;
  border: 1px solid var(--rule);
  border-radius: 12px;
  padding: 1.5rem;
}

.grammar-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 0.75rem;
  gap: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--rule);
}

.grammar-name {
  font-family: var(--body);
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--ink-faint);
}

.grammar-korean {
  font-family: var(--hangul);
  font-size: 1.35rem;
  font-weight: 600;
  color: var(--persimmon);
}

.grammar-explanation {
  font-family: var(--serif);
  font-size: 1rem;
  line-height: 1.65;
  color: var(--ink-soft);
  margin-bottom: 0.85rem;
}

.grammar-example {
  padding: 0.85rem 1rem;
  background: var(--paper);
  border-radius: 8px;
  border-left: 3px solid var(--peach);
}

.grammar-example-korean {
  font-family: var(--hangul);
  font-size: 1.1rem;
  color: var(--ink);
  margin-bottom: 0.25rem;
}

.grammar-example-rom {
  font-family: var(--serif);
  font-style: italic;
  font-size: 0.85rem;
  color: var(--ink-faint);
  margin-bottom: 0.15rem;
}

.grammar-example-eng {
  font-family: var(--body);
  font-size: 0.9rem;
  color: var(--ink-mute);
}

/* Actions */
.lesson-actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  align-items: center;
  margin-top: 1rem;
}

.lesson-cta {
  background: var(--persimmon);
  color: white;
  border: none;
  padding: 1rem 2.5rem;
  border-radius: 12px;
  font-family: var(--hangul);
  font-size: 1.1rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
  box-shadow: 0 4px 12px rgba(197, 106, 74, 0.2);
}

.lesson-cta:hover {
  background: var(--persimmon-deep);
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(197, 106, 74, 0.3);
}

.lesson-regen {
  background: none;
  border: none;
  color: var(--ink-faint);
  font-family: var(--body);
  font-size: 0.85rem;
  cursor: pointer;
  padding: 0.5rem 1rem;
  border-radius: 6px;
}

.lesson-regen:hover:not(:disabled) {
  color: var(--ink-soft);
  background: var(--paper-soft);
}

.lesson-regen:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}


/* ============================================================
   PRONUNCIATION GUIDES
   ============================================================ */
.vocab-pronunciation {
  font-family: var(--mono);
  font-size: 0.85rem;
  color: var(--persimmon);
  background: rgba(197, 106, 74, 0.08);
  padding: 0.4rem 0.65rem;
  border-radius: 6px;
  margin-bottom: 0.5rem;
  letter-spacing: 0.02em;
}

.grammar-example-pronunciation {
  font-family: var(--mono);
  font-size: 0.8rem;
  color: var(--persimmon);
  margin-bottom: 0.15rem;
  letter-spacing: 0.02em;
}


/* ============================================================
   PRONUNCIATION IN CHAT BUBBLES & CORRECTIONS
   ============================================================ */
.bubble .pronunciation,
.correction-fix .pronunciation {
  display: block;
  font-family: var(--mono);
  font-size: 0.78rem;
  color: var(--persimmon);
  background: rgba(197, 106, 74, 0.07);
  padding: 0.3rem 0.55rem;
  border-radius: 5px;
  margin-top: 0.25rem;
  margin-bottom: 0.3rem;
  letter-spacing: 0.02em;
  width: fit-content;
}

.correction-fix .pronunciation {
  background: rgba(197, 106, 74, 0.1);
}


/* ============================================================
   DEMO MODE UI
   ============================================================ */

.demo-banner {
  background: linear-gradient(180deg, rgba(197, 106, 74, 0.08) 0%, rgba(197, 106, 74, 0.02) 100%);
  border-bottom: 1px solid rgba(197, 106, 74, 0.15);
  padding: 0.6rem 1.5rem;
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(8px);
}

.demo-banner-inner {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.demo-banner-label {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-family: var(--body);
  font-size: 0.85rem;
}

.demo-pill {
  display: inline-block;
  background: var(--persimmon);
  color: white;
  font-family: var(--mono);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  padding: 0.2rem 0.55rem;
  border-radius: 4px;
}

.demo-text {
  color: var(--ink-soft);
  font-size: 0.85rem;
}

.demo-progress {
  height: 3px;
  background: rgba(197, 106, 74, 0.12);
  border-radius: 2px;
  overflow: hidden;
}

.demo-progress-fill {
  height: 100%;
  background: var(--persimmon);
  transition: width 0.5s ease;
  border-radius: 2px;
}

/* Block screens (soft-block + daily-full) */
.block-screen {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.block-screen-inner {
  max-width: 520px;
  text-align: center;
}

.block-disc {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--noona);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--hangul);
  font-size: 2rem;
  font-weight: 600;
  color: var(--ink);
  margin: 0 auto 1.5rem;
}

.block-hangul {
  font-family: var(--hangul);
  font-size: 2.2rem;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 0.4rem;
}

.block-romanization {
  font-family: var(--mono);
  font-size: 0.95rem;
  color: var(--persimmon);
  background: rgba(197, 106, 74, 0.08);
  padding: 0.35rem 0.75rem;
  border-radius: 6px;
  display: inline-block;
  margin-bottom: 0.5rem;
}

.block-translation {
  font-family: var(--serif);
  font-style: italic;
  font-size: 0.95rem;
  color: var(--ink-faint);
  margin-bottom: 2.5rem;
}

.block-title {
  font-family: var(--serif);
  font-size: 1.8rem;
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 1.5rem;
  letter-spacing: -0.01em;
}

.block-body {
  font-family: var(--serif);
  font-size: 1.05rem;
  line-height: 1.7;
  color: var(--ink-soft);
  margin-bottom: 1.25rem;
}

.block-body-soft {
  color: var(--ink-faint);
  font-size: 0.95rem;
}

.block-signature {
  margin-top: 2.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--rule);
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.block-signature-hangul {
  font-family: var(--hangul);
  font-size: 1.1rem;
  color: var(--ink-soft);
}

.block-signature-en {
  font-family: var(--mono);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-faint);
}


/* ============================================================
   AUTH / LOCK SCREEN
   ============================================================ */

.auth-loading {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper);
}

.auth-loading-disc {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--noona);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--hangul);
  font-size: 1.4rem;
  font-weight: 600;
  color: var(--ink);
  animation: gentle-pulse 2s ease-in-out infinite;
}

.lock-screen {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.lock-screen-inner {
  text-align: center;
  max-width: 400px;
}

.lock-hangul {
  font-family: var(--hangul);
  font-size: 2.2rem;
  font-weight: 600;
  color: var(--ink-faint);
  margin-bottom: 0.4rem;
}

.lock-romanization {
  font-family: var(--mono);
  font-size: 0.85rem;
  color: var(--ink-mute);
  margin-bottom: 0.3rem;
}

.lock-translation {
  font-family: var(--serif);
  font-style: italic;
  font-size: 0.9rem;
  color: var(--ink-mute);
  margin-bottom: 1.5rem;
}

.lock-message {
  font-family: var(--body);
  font-size: 0.95rem;
  color: var(--ink-faint);
  line-height: 1.6;
}

/* Follow link on soft-block screen */
.block-follow {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.25rem;
  margin: 1.5rem auto 0;
  padding: 0.85rem 1.5rem;
  background: var(--persimmon);
  color: white;
  text-decoration: none;
  border-radius: 12px;
  width: fit-content;
  transition: all 0.2s;
  box-shadow: 0 4px 12px rgba(197, 106, 74, 0.2);
}

.block-follow:hover {
  background: var(--persimmon-deep);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(197, 106, 74, 0.3);
}

.block-follow-label {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  opacity: 0.85;
}

.block-follow-handle {
  font-family: var(--serif);
  font-size: 1.1rem;
  font-weight: 500;
  letter-spacing: -0.01em;
}

/* ============================================================
   HANGUL 101 - Learn the alphabet
   ============================================================ */

/* Callout on scenario picker */
.hangul-callout {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1.25rem 1.5rem;
  margin-bottom: 1.5rem;
  background: linear-gradient(135deg, rgba(197, 106, 74, 0.08), rgba(197, 106, 74, 0.02));
  border: 1px solid rgba(197, 106, 74, 0.2);
  border-radius: 14px;
  cursor: pointer;
  transition: all 0.2s;
}

.hangul-callout:hover {
  border-color: var(--persimmon);
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(197, 106, 74, 0.1);
}

.hangul-callout-icon {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--persimmon);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--hangul);
  font-size: 1.6rem;
  font-weight: 600;
  flex-shrink: 0;
}

.hangul-callout-body {
  flex: 1;
}

.hangul-callout-eyebrow {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--persimmon);
  margin-bottom: 0.3rem;
}

.hangul-callout-title {
  font-family: var(--serif);
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--ink);
  margin: 0 0 0.4rem 0;
}

.hangul-callout-text {
  font-family: var(--body);
  font-size: 0.9rem;
  color: var(--ink-soft);
  margin: 0;
  line-height: 1.5;
}

.hangul-callout-arrow {
  font-size: 1.4rem;
  color: var(--persimmon);
  flex-shrink: 0;
}

/* Lesson list */
.hangul-list-loading {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper);
}

.hangul-list {
  min-height: 100vh;
  background: var(--paper);
}

.hangul-list-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 2rem;
  border-bottom: 1px solid var(--rule);
  background: var(--paper-soft);
}

.hangul-list-title-block {
  text-align: center;
  flex: 1;
}

.hangul-list-eyebrow {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-faint);
  margin-bottom: 0.3rem;
}

.hangul-list-title-block h1 {
  font-family: var(--serif);
  font-size: 1.6rem;
  font-weight: 500;
  color: var(--ink);
  margin: 0 0 0.3rem 0;
}

.hangul-list-title-block p {
  font-family: var(--body);
  font-size: 0.9rem;
  color: var(--ink-soft);
  margin: 0;
}

.hangul-list-body {
  max-width: 640px;
  margin: 0 auto;
  padding: 2rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
}

.hangul-lesson-card {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  padding: 1.25rem 1.5rem;
  background: white;
  border: 1px solid var(--rule);
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.2s;
}

.hangul-lesson-card:hover:not(.locked) {
  border-color: var(--persimmon);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(90, 65, 51, 0.06);
}

.hangul-lesson-card.locked {
  opacity: 0.55;
  cursor: not-allowed;
}

.hangul-lesson-card.completed {
  background: var(--paper-soft);
}

.hangul-lesson-number {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--serif);
  font-size: 1.1rem;
  color: var(--ink-soft);
  border: 1px solid var(--rule);
  flex-shrink: 0;
}

.hangul-lesson-card.completed .hangul-lesson-number {
  background: var(--persimmon);
  color: white;
  border-color: var(--persimmon);
}

.hangul-lesson-info {
  flex: 1;
}

.hangul-lesson-title {
  font-family: var(--serif);
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--ink);
}

.hangul-lesson-subtitle {
  font-family: var(--body);
  font-size: 0.85rem;
  color: var(--ink-soft);
  margin-top: 0.15rem;
}

.hangul-lesson-meta {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-faint);
  margin-top: 0.4rem;
}

.hangul-lesson-lock {
  font-size: 1.1rem;
  opacity: 0.6;
}

.hangul-demo-wall {
  margin-top: 1rem;
  padding: 1.5rem;
  text-align: center;
  background: var(--paper-soft);
  border: 1px dashed var(--rule);
  border-radius: 12px;
}

.hangul-demo-wall p {
  margin: 0 0 1rem 0;
  font-family: var(--serif);
  color: var(--ink-soft);
}

/* Single lesson screen */
.hangul-lesson-screen {
  min-height: 100vh;
  background: var(--paper);
  display: flex;
  flex-direction: column;
}

.hangul-lesson-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 2rem;
  border-bottom: 1px solid var(--rule);
  background: var(--paper-soft);
}

.hangul-lesson-progress {
  display: flex;
  gap: 0.4rem;
}

.progress-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--rule);
  transition: all 0.2s;
}

.progress-dot.current {
  background: var(--persimmon);
  transform: scale(1.3);
}

.progress-dot.done {
  background: var(--peach);
}

.hangul-lesson-content {
  flex: 1;
  max-width: 640px;
  margin: 0 auto;
  padding: 2.5rem 2rem;
  width: 100%;
}

.hangul-lesson-meta-top {
  margin-bottom: 2rem;
}

.hangul-lesson-eyebrow {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-faint);
}

.hangul-section {
  background: white;
  border: 1px solid var(--rule);
  border-radius: 16px;
  padding: 2.5rem 2rem;
  text-align: center;
}

.hangul-section h2 {
  font-family: var(--serif);
  font-size: 1.5rem;
  font-weight: 500;
  color: var(--ink);
  margin: 0 0 1.25rem 0;
}

.hangul-section p {
  font-family: var(--serif);
  font-size: 1.05rem;
  line-height: 1.75;
  color: var(--ink-soft);
  margin: 0;
  text-align: left;
}

.hangul-example-box {
  margin-top: 2rem;
  padding: 1.5rem;
  background: var(--paper);
  border-radius: 12px;
}

.hangul-example-korean {
  font-family: var(--hangul);
  font-size: 2rem;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 0.5rem;
}

.hangul-example-rom {
  font-family: var(--mono);
  font-size: 0.85rem;
  color: var(--persimmon);
  margin-bottom: 0.3rem;
}

.hangul-example-eng {
  font-family: var(--serif);
  font-style: italic;
  color: var(--ink-soft);
  margin-bottom: 0.85rem;
}

.hangul-example-breakdown {
  font-family: var(--mono);
  font-size: 0.8rem;
  color: var(--ink-faint);
  padding-top: 0.75rem;
  border-top: 1px dashed var(--rule);
}

/* Letter display */
.hangul-letter-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 1.5rem;
}

.hangul-letter-char {
  font-family: var(--hangul);
  font-size: 7rem;
  font-weight: 600;
  color: var(--ink);
  line-height: 1;
  margin-bottom: 1rem;
}

.hangul-letter-audio {
  background: var(--persimmon);
  color: white;
  border: none;
  padding: 0.7rem 1.5rem;
  border-radius: 30px;
  font-family: var(--body);
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.2s;
}

.hangul-letter-audio:hover {
  background: var(--persimmon-deep);
}

.hangul-letter-audio.playing {
  animation: gentle-pulse 1s ease-in-out infinite;
}

.hangul-letter-info {
  text-align: center;
  margin-bottom: 1.5rem;
}

.hangul-letter-rom {
  font-family: var(--mono);
  font-size: 1.2rem;
  color: var(--persimmon);
  margin-bottom: 0.4rem;
}

.hangul-letter-sound {
  font-family: var(--serif);
  font-style: italic;
  font-size: 1rem;
  color: var(--ink-soft);
}

.hangul-letter-tip {
  text-align: left;
  background: var(--paper);
  padding: 1rem;
  border-radius: 10px;
  font-family: var(--body);
  font-size: 0.9rem;
  color: var(--ink-soft);
  margin-bottom: 1rem;
  line-height: 1.5;
}

.hangul-letter-tip .tip-label {
  font-family: var(--mono);
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--persimmon);
  background: rgba(197, 106, 74, 0.1);
  padding: 0.15rem 0.5rem;
  border-radius: 4px;
  margin-right: 0.5rem;
  display: inline-block;
}

.hangul-letter-callout {
  background: rgba(197, 106, 74, 0.06);
  border-left: 3px solid var(--persimmon);
  padding: 0.85rem 1rem;
  text-align: left;
  font-family: var(--serif);
  font-size: 0.95rem;
  color: var(--ink-soft);
  line-height: 1.6;
}

/* Completion section */
.hangul-section.completion {
  text-align: center;
}

.completion-disc {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--persimmon);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  margin: 0 auto 1.5rem;
}

.hangul-section.completion p {
  text-align: center;
}

/* Nav */
.hangul-lesson-nav {
  padding: 1.25rem 2rem;
  border-top: 1px solid var(--rule);
  background: var(--paper-soft);
  display: flex;
  align-items: center;
  gap: 1rem;
}

.nav-prev,
.nav-next,
.nav-complete {
  padding: 0.75rem 1.5rem;
  border: none;
  border-radius: 10px;
  font-family: var(--body);
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

.nav-prev {
  background: var(--paper);
  color: var(--ink-soft);
  border: 1px solid var(--rule);
}

.nav-next,
.nav-complete {
  background: var(--persimmon);
  color: white;
}

.nav-next:hover,
.nav-complete:hover {
  background: var(--persimmon-deep);
}

.nav-prev:hover {
  background: white;
}

/* ============================================================
   HANGUL LIST - mobile fixes
   ============================================================ */
@media (max-width: 640px) {
  .hangul-list-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1.5rem;
  }
  
  .hangul-list-header .back-btn {
    align-self: flex-start;
    padding: 0.4rem 0.75rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  
  .hangul-list-title-block {
    text-align: left;
    width: 100%;
  }
  
  .hangul-list-title-block h1 {
    font-size: 1.4rem;
  }
  
  /* Hide the empty spacer div on mobile */
  .hangul-list-header > div[style*="width: 100"] {
    display: none;
  }
  
  /* Same fix for lesson header */
  .hangul-lesson-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.5rem;
  }
  
  .hangul-lesson-header .back-btn {
    align-self: flex-start;
    padding: 0.4rem 0.75rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 8px;
  }
  
  .hangul-lesson-header > div[style*="width: 100"] {
    display: none;
  }
  
  .hangul-letter-char {
    font-size: 5rem;
  }
  
  .hangul-section {
    padding: 1.75rem 1.25rem;
  }
  
  .hangul-list-body {
    padding: 1.5rem 1rem;
  }
}

/* ============================================================
   BACK BUTTON FIX - allow text version in Hangul screens
   ============================================================ */
.hangul-list-header .back-btn,
.hangul-lesson-header .back-btn {
  width: auto;
  height: auto;
  padding: 0.5rem 0.85rem;
  border-radius: 8px;
  font-family: var(--body);
  font-size: 0.9rem;
  color: var(--ink-soft);
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  white-space: nowrap;
}

.hangul-list-header .back-btn:hover,
.hangul-lesson-header .back-btn:hover {
  background: var(--paper-deep);
  color: var(--ink);
}

/* ============================================================
   HANGUL PRACTICE - recognition + syllable-build
   ============================================================ */

.recognition-prompt {
  text-align: center !important;
  font-size: 1.15rem !important;
  margin-bottom: 1.5rem !important;
}

.recognition-options {
  display: flex;
  gap: 0.85rem;
  justify-content: center;
  margin-bottom: 1.25rem;
  flex-wrap: wrap;
}

.recognition-option {
  width: 80px;
  height: 80px;
  border-radius: 16px;
  background: white;
  border: 2px solid var(--rule);
  font-family: var(--hangul);
  font-size: 2.5rem;
  font-weight: 600;
  color: var(--ink);
  cursor: pointer;
  transition: all 0.2s;
}

.recognition-option:hover:not(:disabled) {
  border-color: var(--persimmon);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(197, 106, 74, 0.1);
}

.recognition-option.selected.correct {
  background: rgba(120, 160, 100, 0.15);
  border-color: #78a064;
  color: #4a6a3a;
}

.recognition-option.selected.wrong {
  background: rgba(220, 100, 90, 0.12);
  border-color: #d05858;
  color: #b04848;
}

.recognition-option:disabled {
  cursor: default;
}

.recognition-feedback {
  padding: 0.85rem 1rem;
  border-radius: 10px;
  font-family: var(--serif);
  font-size: 0.95rem;
  line-height: 1.5;
  text-align: center;
}

.recognition-feedback.correct {
  background: rgba(120, 160, 100, 0.1);
  color: #4a6a3a;
}

.recognition-feedback.wrong {
  background: rgba(220, 100, 90, 0.08);
  color: #884040;
}

.recognition-feedback strong {
  font-family: var(--hangul);
  font-weight: 600;
  margin-right: 0.4rem;
}

/* Syllable Builder */
.syllable-build .recognition-prompt {
  text-align: center !important;
}

.builder-output {
  background: var(--paper);
  border-radius: 14px;
  padding: 1.5rem;
  text-align: center;
  margin-bottom: 1.5rem;
}

.builder-output-label {
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-faint);
  margin-bottom: 0.75rem;
}

.builder-output-word {
  font-family: var(--hangul);
  font-size: 3rem;
  font-weight: 600;
  color: var(--ink);
  min-height: 3.5rem;
  letter-spacing: 0.05em;
}

.builder-placeholder {
  color: var(--ink-faint);
  opacity: 0.4;
}

.builder-success {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px dashed var(--rule);
  font-family: var(--serif);
  font-size: 1.05rem;
  color: var(--ink-soft);
}

.builder-success strong {
  font-family: var(--hangul);
  font-size: 1.4rem;
  color: var(--persimmon);
}

.builder-letters {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: 1.25rem;
}

.builder-letter {
  width: 56px;
  height: 56px;
  border-radius: 12px;
  background: white;
  border: 2px solid var(--rule);
  font-family: var(--hangul);
  font-size: 1.8rem;
  font-weight: 600;
  color: var(--ink);
  cursor: pointer;
  transition: all 0.2s;
}

.builder-letter:hover:not(:disabled) {
  border-color: var(--persimmon);
  background: var(--paper);
  transform: translateY(-2px);
}

.builder-letter:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.builder-actions {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.builder-reset,
.builder-hint {
  background: none;
  border: none;
  color: var(--ink-faint);
  font-family: var(--body);
  font-size: 0.85rem;
  cursor: pointer;
  padding: 0.4rem 0.85rem;
  border-radius: 6px;
}

.builder-reset:hover:not(:disabled),
.builder-hint:hover {
  color: var(--ink-soft);
  background: var(--paper-soft);
}

.builder-reset:disabled {
  opacity: 0.3;
}

.builder-hint-text {
  margin-top: 0.5rem;
  padding: 0.85rem 1rem;
  background: rgba(197, 106, 74, 0.06);
  border-left: 3px solid var(--persimmon);
  border-radius: 8px;
  font-family: var(--serif);
  font-size: 0.9rem;
  color: var(--ink-soft);
  text-align: left;
  line-height: 1.5;
}

/* Disabled continue button */
.nav-next:disabled {
  background: var(--rule);
  cursor: not-allowed;
  opacity: 0.5;
}

/* Consonant audio explanation note */
.consonant-note {
  margin-top: 1rem;
  padding: 0.65rem 0.85rem;
  background: rgba(197, 106, 74, 0.06);
  border-radius: 8px;
  font-family: var(--serif);
  font-size: 0.85rem;
  color: var(--ink-soft);
  line-height: 1.5;
  max-width: 360px;
}

.consonant-note em {
  color: var(--persimmon);
  font-style: italic;
  font-weight: 500;
}

/* Word audio button on builder success */
.builder-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.85rem;
}

.builder-success-text {
  font-family: var(--serif);
  font-size: 1.05rem;
  color: var(--ink-soft);
}

.word-audio-btn {
  background: var(--persimmon);
  color: white;
  border: none;
  padding: 0.55rem 1.25rem;
  border-radius: 24px;
  font-family: var(--body);
  font-size: 0.9rem;
  cursor: pointer;
  transition: all 0.2s;
}

.word-audio-btn:hover:not(:disabled) {
  background: var(--persimmon-deep);
  transform: translateY(-1px);
}

.word-audio-btn.playing {
  animation: gentle-pulse 1s ease-in-out infinite;
}

.word-audio-btn:disabled {
  opacity: 0.6;
  cursor: wait;
}
